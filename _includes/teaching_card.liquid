{% comment %}Single teaching/supervision card. Pass: course{% endcomment %}
{% assign course = include.course %}
<div class="teaching-card">
  <div class="teaching-card-head">
    <h3 class="teaching-title">
      {% if course.url %}
        <a href="{{ course.url }}" target="_blank" rel="noopener noreferrer">{{ course.title }}</a>
      {% else %}
        {{ course.title }}
      {% endif %}
    </h3>
    {% if course.level -%}
      <span class="teaching-level">{{ course.level }}</span>
    {%- endif %}
  </div>
  {% assign meta = '' %}
  {% if course.term %}{% assign meta = course.term | append: ' semester' %}{% endif %}
  {% if course.role %}
    {% if meta != '' %}{% assign meta = meta | append: ' · ' | append: course.role %}{% else %}{% assign meta = course.role %}{% endif %}
  {% endif %}
  {% if meta != '' %}
    <p class="teaching-role">{{ meta }}</p>
  {% endif %}
  {% if course.description %}
    <p class="teaching-desc">{{ course.description }}</p>
  {% endif %}
</div>
